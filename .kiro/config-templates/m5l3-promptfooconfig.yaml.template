# m5l3-promptfooconfig.yaml — evaluate the review prompt across models (M5L3).
# Copy to <reviewer-dir>/promptfooconfig.yaml. Run: OPENROUTER_API_KEY=... npx promptfoo eval
# promptfoo needs Node 22.22+. prompts/review.txt holds the system prompt from
# review-schema.ts plus a {{diff}} placeholder and an instruction to answer with JSON
# matching REVIEW_SCHEMA (six scores, verdict, summary).
description: Code review agent — same diffs, several models

providers:
  - id: openrouter:z-ai/glm-5.3
  - id: openrouter:deepseek/deepseek-v4.1-flash
  - id: openrouter:openai/gpt-5.6-luna

prompts:
  - file://prompts/review.txt

defaultTest:
  options:
    # llm-rubric grader; any OpenRouter model works here
    provider: openrouter:anthropic/claude-sonnet-5.5

tests:
  - description: React 16 -> 19 migration with three planted flaws
    vars:
      diff: file://fixtures/react19-migration.diff
    assert:
      # 1. valid JSON — the CI gate depends on it
      - type: is-json
      # 2. a second model checks that the review names what is broken
      - type: llm-rubric
        value: The review identifies all three planted flaws and explains why each one breaks the component
      # 3. hard condition on the binding verdict from the Definition of Done
      - type: javascript
        value: JSON.parse(output).verdict === "fail"

  - description: SQL injection
    vars:
      diff: file://fixtures/sql-injection.diff
    assert:
      - type: is-json
      - type: llm-rubric
        value: The review rejects the change and points to the SQL injection
      - type: javascript
        value: JSON.parse(output).verdict === "fail" && JSON.parse(output).securitySafety <= 3
